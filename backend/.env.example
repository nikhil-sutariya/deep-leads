# =============================================================================
# DeepLeads AI — environment configuration
# Copy this file to `.env` and fill in real values.
# Every variable here mirrors a field on `app.core.config.Settings`.
# Pydantic-settings reads them case-insensitively, but UPPER_SNAKE_CASE is the
# standard convention.
# =============================================================================


# -----------------------------------------------------------------------------
# AI provider — API keys
# -----------------------------------------------------------------------------

# REQUIRED. Google Gemini API key — used by the prompt builder, lead discovery,
# lead enrichment, and email campaign agents.
GOOGLE_API_KEY=your-google-gemini-api-key

# Optional. Only needed if AI_PROVIDER is set to "perplexity".
PERPLEXITY_API_KEY=


# -----------------------------------------------------------------------------
# Provider configuration
# -----------------------------------------------------------------------------

# Which AI provider the discovery / enrichment agents use as the search engine.
# Options: "gemini" (default) or "perplexity".
AI_PROVIDER=gemini


# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------

# Postgres connection string. The app uses asyncpg at runtime; alembic
# normalises this to a sync URL internally, so the same value works for both.
# Examples:
#   postgresql+asyncpg://user:password@localhost:5432/deepleads
#   postgresql://user:password@localhost:5432/deepleads
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/deepleads


# -----------------------------------------------------------------------------
# Authentication / JWT
# -----------------------------------------------------------------------------

# REQUIRED. Long random string used to sign JWTs.
# Generate one with: `openssl rand -hex 32`
SECRET_KEY=replace-with-a-long-random-secret

# REQUIRED. JWT signing algorithm. HS256 is the standard for symmetric secrets.
OAUTH_ALGORITHM=HS256

# REQUIRED. How long an access token is valid for.
ACCESS_TOKEN_EXPIRE_MINUTES=60

# REQUIRED. How long a refresh token is valid for.
REFRESH_TOKEN_EXPIRE_DAYS=7

# Allowed frontend origins (JSON array of strings).
# Examples:
#   ["http://localhost:3000"]
#   ["http://localhost:3000","https://app.example.com"]
CLIENT_ORIGIN=["http://localhost:3000"]


# -----------------------------------------------------------------------------
# Email (SMTP) — used by the forgot-password flow
# -----------------------------------------------------------------------------

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=


# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------

# "development" or "production". Controls cookie `secure` flag, error verbosity,
# uvicorn reload, and SQLAlchemy `echo`.
ENVIRONMENT=development

# Log level for loguru (DEBUG / INFO / WARNING / ERROR).
LOG_LEVEL=INFO

# Default cap on how many leads a single search returns.
MAX_LEADS_PER_SEARCH=50

# Generic per-minute rate limit knob (not currently wired anywhere).
RATE_LIMIT_PER_MINUTE=30


# -----------------------------------------------------------------------------
# Lead discovery — legacy filter defaults (kept for backwards compatibility)
# -----------------------------------------------------------------------------
# NOTE: the new free-form discovery flow does NOT use these — the user's plain-
# English query drives company-size / funding targeting now. They remain on
# Settings only because nothing else has been removed from config.py yet.

MIN_COMPANY_SIZE=10
MAX_COMPANY_SIZE=100
MIN_FUNDING_MILLIONS=0.5
MAX_FUNDING_MILLIONS=10.0


# -----------------------------------------------------------------------------
# Outbound search configuration
# -----------------------------------------------------------------------------

SEARCH_TIMEOUT_SECONDS=30
MAX_RETRIES=3


# -----------------------------------------------------------------------------
# Default admin user (seeded on first startup via lifespan)
# -----------------------------------------------------------------------------

DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=Admin@1234


# -----------------------------------------------------------------------------
# Docker Compose only — not read by the app, used for variable substitution
# inside docker-compose.yml to seed the Postgres container and build the
# in-network DATABASE_URL.
# -----------------------------------------------------------------------------

POSTGRES_USER=deepleads
POSTGRES_PASSWORD=deepleads
POSTGRES_DB=deepleads
POSTGRES_PORT=5432
APP_PORT=8000
